# Example Fly.io config for the hosted API + worker app.
# No deployment is maintained; replace app, primary_region, hostnames, and Redis address before deploying.

app = "replace-me-arena-api"
primary_region = "iad"
kill_signal = "SIGINT"
kill_timeout = "10s"

[build]
  dockerfile = "../../Dockerfile.backend"

  [build.args]
    CMD = "arena-host"

[env]
  ARENA_ENV = "exposed"
  ARENA_HTTP_ADDR = ":8080"
  ARENA_DB_PATH = "/data/arena.db"
  ARENA_LOG_DIR = "/data/logs"
  ARENA_EXPORT_DIR = "/data/exports"
  ARENA_FRONTEND_ORIGIN = "https://arena-ui.example.invalid"
  ARENA_ALLOWED_ORIGINS = "https://arena-ui.example.invalid"
  ARENA_PUBLIC_TEAM_ACTIVITY = "summary"
  ARENA_LEGACY_TEAM_TOKEN_AUTH = "false"
  ARENA_RATE_LIMIT_ENABLED = "true"
  ARENA_RATE_LIMIT_FAIL_CLOSED = "true"
  ARENA_VENUE = "fake"
  ARENA_REDIS_ADDR = "arena-redis.example.invalid:6379"

[mounts]
  source = "arena_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "30s"
    method = "GET"
    path = "/health"
    protocol = "http"

[[vm]]
  memory = "1gb"
  cpu_kind = "shared"
  cpus = 1

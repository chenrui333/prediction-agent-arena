# Example Fly.io config for the hosted Next.js frontend app.
# No deployment is maintained; replace app, primary_region, and API URL before deploying.

app = "replace-me-arena-ui"
primary_region = "iad"
kill_signal = "SIGINT"
kill_timeout = "10s"

[build]
  dockerfile = "../../Dockerfile.frontend"

  [build.args]
    NEXT_PUBLIC_ARENA_API_BASE_URL = "https://arena-api.example.invalid"

[env]
  NEXT_PUBLIC_ARENA_API_BASE_URL = "https://arena-api.example.invalid"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  memory = "1gb"
  cpu_kind = "shared"
  cpus = 1

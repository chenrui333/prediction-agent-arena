FROM golang:1.26.2-alpine AS build

WORKDIR /src/backend
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./

ARG CMD=arena-api
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/arena ./cmd/${CMD}

FROM alpine:3.22

RUN adduser -D -u 10001 arena
WORKDIR /app
COPY --from=build /out/arena /usr/local/bin/arena
USER arena

ENTRYPOINT ["/usr/local/bin/arena"]
